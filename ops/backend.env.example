# Runtime secrets for the deploy controller. Install as /etc/moment/backend.env.
DASHBOARD_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
DEVICE_API_TOKEN=replace-with-the-same-token-as-the-ESP32
SECRET_KEY=replace-with-a-long-random-session-secret
DATA_DIR=/data
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=Moment
