# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('change-me'))"
DASHBOARD_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
DEVICE_API_TOKEN=replace-with-a-long-random-device-token
SECRET_KEY=replace-with-a-long-random-session-secret

DATA_DIR=/data
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Create a key at https://openrouter.ai/keys. Do not commit it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Optional usage-attribution metadata.
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=Moment
